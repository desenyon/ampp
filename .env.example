# AMPP Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── LLM Provider ────────────────────────────────────────────────────────────

# Override provider selection:
#   "openai"     - use OpenAI API (default)
#   "anthropic"  - use Anthropic API
# AMPP_LLM_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=sk-...

# Optional: custom base URL enables OpenClaw, Azure OpenAI, vLLM, Ollama, etc.
# When set, all OpenAI client calls go to this endpoint instead.
# OPENAI_BASE_URL=https://your-openclaw-endpoint.example.com/v1

# Model overrides (defaults shown)
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-5

# Anthropic (opt-in; set AMPP_LLM_PROVIDER=anthropic or leave OPENAI_API_KEY unset)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM call settings
# AMPP_LLM_MAX_TOKENS=2048
# AMPP_LLM_TEMPERATURE=0.2
# AMPP_LLM_RETRIES=3

# ─── Pipeline ─────────────────────────────────────────────────────────────────

# AMPP_MAX_ITERATIONS=200
# AMPP_BEAM_WIDTH=4
# AMPP_STALE_THRESHOLD=10
# AMPP_RANDOM_SEED=42
# AMPP_MAX_CANDIDATES_PER_PROPOSER=3

# ─── Verifiers ───────────────────────────────────────────────────────────────

# Optional: override solver paths
# LEAN_PATH=/usr/local/bin/lean
# VAMPIRE_PATH=/usr/local/bin/vampire
# E_PROVER_PATH=/usr/local/bin/eprover

# AMPP_Z3_TIMEOUT_MS=30000
# AMPP_LEAN_TIMEOUT_SEC=120
# AMPP_ATP_TIMEOUT_SEC=30
# AMPP_V1_RANDOM_TRIALS=500
# AMPP_V1_MAX_ENUM_BOUND=10000

# ─── Rubric ──────────────────────────────────────────────────────────────────

# AMPP_RUBRIC_PASS_THRESHOLD=70

# ─── Artifacts ───────────────────────────────────────────────────────────────

# AMPP_OUTPUT_DIR=output
# AMPP_DB_PATH=ampp_state.db

# ─── Logging ─────────────────────────────────────────────────────────────────

# Rust tracing filter (info | debug | trace)
RUST_LOG=ampp=info
