# AMPP does not auto-load .env. In bash/zsh: set -a; source .env; set +a
# Default to offline; change explicitly when you want model API calls.
AMPP_LLM_PROVIDER=null

# OPENAI_API_KEY=your-key
# OPENAI_MODEL=your-available-model
# OPENAI_BASE_URL=http://localhost:11434/v1
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_MODEL=your-available-model
# AMPP_LLM_RETRIES=3
# AMPP_LLM_MAX_TOKENS=2048
# AMPP_LLM_TEMPERATURE=0.2

# Lean executable, not LEAN_PATH (which is a library search path).
# AMPP_LEAN_BINARY=/absolute/path/to/toolchain/bin/lean
# AMPP_LEAN_PROJECT=/absolute/path/to/trusted/lake/project
# AMPP_LEAN_IMPORTS=Mathlib
# AMPP_LEAN_TIMEOUT_SEC=120
# AMPP_Z3_TIMEOUT_MS=30000
# AMPP_V1_RANDOM_TRIALS=500
# AMPP_V1_MAX_ENUM_BOUND=10000

# Use CLI flags for --max-iter, --seed, --db, --output, --worker-timeout.
RUST_LOG=ampp=info
