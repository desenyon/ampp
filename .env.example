# ── LLM API keys (at least one required for production proposer ensemble) ─────
# OpenAI (gpt-4o is the default model)
OPENAI_API_KEY=sk-...

# Anthropic (claude-opus-4-5 is the default model; takes priority if both set)
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: override solver paths ───────────────────────────────────────────
# LEAN_PATH=/usr/local/bin/lean
# VAMPIRE_PATH=/usr/local/bin/vampire
# E_PROVER_PATH=/usr/local/bin/eprover

# ── Logging ───────────────────────────────────────────────────────────────────
# Rust tracing filter (info | debug | trace)
RUST_LOG=ampp=info
